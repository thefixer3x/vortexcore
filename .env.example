# VortexCore Environment Configuration Template
# Copy this file and fill in the actual values from Google Cloud Secrets Manager.
#
# Secret names follow the pattern: vortexcore_<category>_<name>
# Project: lanonasis-knowledge-poc
#
# To retrieve a secret:
#   gcloud secrets versions access latest \
#     --secret="vortexcore_<name>" \
#     --project=lanonasis-knowledge-poc
#
# Or use the helper script:
#   ./scripts/load-gcloud-secrets.sh

# ─── Infrastructure ──────────────────────────────────────────────
POSTGRES_PASSWORD=
READONLY_PASSWORD=
REDIS_PASSWORD=
KONG_PG_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# ─── Supabase ────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Services ─────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ─── Payment: Stripe ─────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT=

# ─── Payment: SaySwitch ──────────────────────────────────────────
SAYSWITCH_SECRET_KEY=
SAYSWITCH_PUBLISHABLE_KEY=

# ─── EDoc / Bank Statement API ───────────────────────────────────
EDOC_SK=
EDOC_PK=
EDOC_CLIENT_ID=

# ─── Identity Verification: Prembly ──────────────────────────────
PREMBLY_SECRET_KEY=
PREMBLY_PUBLIC_KEY=

# ─── Auth Service (services/auth-service) ────────────────────────
